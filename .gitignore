/data/

# runs/: only our own trained weights (runs/gripper/{cls,train}/<name>/weights/best.pt) are kept
/runs/*
!/runs/gripper/
/runs/gripper/*
!/runs/gripper/cls/
!/runs/gripper/train/
/runs/gripper/cls/*/*
/runs/gripper/train/*/*
!/runs/gripper/cls/*/weights/
!/runs/gripper/train/*/weights/

# downloaded model weights (see README section 1)
*.pt
*.pth
*.safetensors
*.onnx
subtask_seg/weights/
!/runs/gripper/*/*/weights/best.pt

# Python / OS
__pycache__/
*.py[cod]
.DS_Store
.venv*/

# logs
*.log
subtask_seg/logs/
subtask_seg/logss/

# caches and intermediate outputs (regenerated by the pipeline)
subtask_seg/results/cache/
subtask_seg/results/run_log.txt
*.pkl
*.cache

# task player: decoded frames and uploads (task_player.py regenerates them)
players/
task_player_assets/.uploads/
*.ground_truth.draft.json
